@@ -0,0 +1,265 @@
+/* eslint-disable max-lines */
+import { createAsyncThunk, unwrapResult } from "@reduxjs/toolkit";
+
+import { AccountId } from "@kohaku-eth/plugins";
+import { createTx, TxData } from "@kohaku-eth/provider";
+import { generatePrivateKey, privateKeyToAccount } from "viem/accounts";
+import { encodeFunctionData, erc20Abi, type Hex } from "viem";
+
+import { reasonableGasUnitsForBatch } from "../../paymaster/fee";
+import { RelayerPaymasterClient, relayerPaymasterAbi } from "../../paymaster/relayer-paymaster-client";
+import { buildSignedTornadoUserOp, createPaymasterBundlerClient, estimateUserOperationGas, isDelegatedToSimple7702 } from "../../paymaster/utils";
+import { addressToHex } from "../../utils";
+import { UserOpGasLimits } from "../../interfaces/user-ops.interface";
+import { Address } from "../../interfaces/types.interface";
+import { DelegatorAccount } from "../../account/delegation.interface";
+import { IWithdrawalPayload } from "../../plugin/interfaces/protocol-params.interface";
+import { instanceRegistryInfoSelector, poolsSelector } from "../selectors/slices.selectors";
+import { RootState } from "../store";
+import { verifyRootsThunk } from "./verifyRootsThunk";
+import { withdrawalsProofThunk } from "./withdrawalsProofThunk";
+import { getWithdrawableDepositsSelector } from "../selectors/withdrawals.selector";
+import { TornadoProveOutput } from "../../utils/tornado-prover";
+import { IGenericPaymasterWithdrawalPayload } from "../../relayer/interfaces/paymaster-client.interface";
+import type { PaymasterWithdrawThunkParams } from "./paymasterWithdrawThunk";
+
+/**
+ * Relayer-signed paymaster withdrawals (thin Tornado relayer over ERC-4337).
+ *
+ * Differences from `paymasterWithdrawThunk` (trustless PrivacyPaymaster):
+ *  - the sponsoring withdraw is part of the userOp callData: the 7702 sender calls
+ *    `paymaster.relayWithdraw(...)`, which forwards it through the DAO's
+ *    TornadoRouter (RelayerRegistry burn, as for any registered relayer), then
+ *    runs the direct withdraws and the tail calls;
+ *  - the proof binds `relayer = quote.relayer` (the paymaster, or the master EOA
+ *    of an existing relayer the paymaster works for) and `fee = relayer quote`
+ *    (in the pool asset: wei for ETH pools, token units for ERC-20 pools, priced
+ *    by the relayer); in master mode the paymaster refunds
+ *    `fee - actual gas - service fee` to `refundTo` in postOp, in the same asset;
+ *  - `paymasterData` is a relayer signature obtained through ERC-7677
+ *    (`pm_getPaymasterStubData` for estimation, `pm_getPaymasterData` to send).
+ *
+ * Selected automatically by `paymasterWithdrawThunk` when
+ * `paymasterConfig[chainId].relayer` is configured.
+ */
+export const relayerPaymasterWithdrawThunk = createAsyncThunk<
+  IWithdrawalPayload[],
+  PaymasterWithdrawThunkParams,
+  { state: RootState; }
+>('withdraw/executeRelayerPaymasterWithdrawals', async ({
+  dataService,
+  assetAddress,
+  amount,
+  paymasterSettings: {
+    delegation,
+    ...paymasterConfig
+  },
+  secretManager,
+  tailCalls,
+  tailCallsGasEstimate,
+  ...rest
+}, { getState, dispatch }) => {
+  const state = getState();
+  const { chainId: rawChainId } = instanceRegistryInfoSelector(state);
+  const chainId = Number(rawChainId);
+  const deposits = getWithdrawableDepositsSelector(state, assetAddress, amount);
+  const poolsToWithdrawFrom = [...new Set(deposits.map((d) => d.pool))];
+
+  const pools = poolsSelector(state);
+  const poolInfo = pools.get(deposits[0]!.pool);
+
+  if (!poolInfo) throw new Error(`No pool found for asset ${assetAddress}`);
+
+  const chainConfig = paymasterConfig[chainId];
+
+  if (!chainConfig?.relayer) throw new Error(`No relayer paymaster configured for chain ${chainId}`);
+
+  const { bundlerUrl, entryPointAddress, relayer: { url: relayerUrl } } = chainConfig;
+
+  unwrapResult(
+    await dispatch(verifyRootsThunk({
+      dataService,
+      onlyThesePools: poolsToWithdrawFrom
+    }))
+  );
+
+  const relayerClient = new RelayerPaymasterClient(relayerUrl);
+  const bundlerClient = createPaymasterBundlerClient(bundlerUrl);
+  const bigintChainId = await dataService.getChainId();
+  const { recipient: originalRecipient, ...restWithoutRecipient } = rest;
+  const originalRecipientHex = addressToHex(originalRecipient);
+
+  const prove = async (
+    deposit: (typeof deposits)[number],
+    recipient: Address,
+    relayer: Address,
+    depositFee: bigint,
+  ): Promise<TornadoProveOutput> =>
+    unwrapResult(await dispatch(withdrawalsProofThunk({
+      ...restWithoutRecipient,
+      recipient,
+      deposit,
+      relayerAddress: relayer,
+      fee: depositFee,
+    })));
+
+  const ephemeralSigner = async (deposit: (typeof deposits)[number]): Promise<DelegatorAccount> =>
+    privateKeyToAccount(
+      deposit.kind === 'legacy'
+        ? await secretManager.deriveLegacyEphemeralSigner({ nullifier: deposit.nullifier })
+        : await secretManager.deriveEphemeralSigner({
+            depositIndex: deposit.depositIndex,
+            chainId: bigintChainId,
+            poolAddress: deposit.pool,
+          })
+    );
+
+  const resolveIndependentSigner = (deposit: (typeof deposits)[number]): Promise<DelegatorAccount> =>
+    delegation?.mode === 'deterministic'
+      ? ephemeralSigner(deposit)
+      : Promise.resolve(privateKeyToAccount(generatePrivateKey()));
+
+  // One note per UserOperation: every relayed withdrawal goes through TornadoRouter on its
+  // own (one registry burn per note, exactly as with a classic relayer), so a multi-note
+  // unshield becomes several independent operations, each with its own sender, quote,
+  // proof, sponsorship and tail. The relayer refuses operations carrying more than one
+  // Tornado withdrawal.
+  const SPONSORING_WITHDRAW_GAS = 400_000n;
+  // Gas for the tail: the user's calls, or the single forward transfer.
+  const batchGas = reasonableGasUnitsForBatch(poolInfo.isERC20, 0, true, tailCallsGasEstimate);
+  const tailCallsGas = batchGas.callGasLimit + SPONSORING_WITHDRAW_GAS;
+  const sponsorContext = { refundTo: originalRecipientHex };
+
+  // The sponsoring note: `paymaster.relayWithdraw` (Router / RelayerRegistry path). The
+  // paymaster only accepts the recipient as caller, which the sender is.
+  const relayWithdrawCall = (paymaster: `0x${string}`, poolAddress: Address, proof: TornadoProveOutput): TxData => {
+    const [root, nullifierHash, proofRecipient, relayerArg, feeArg] = proof.args;
+    const data = encodeFunctionData({
+      abi: relayerPaymasterAbi,
+      functionName: 'relayWithdraw',
+      args: [addressToHex(poolAddress), proof.proof, root, nullifierHash, proofRecipient, relayerArg, BigInt(feeArg)],
+    });
+
+    return createTx(paymaster, data, 0n);
+  };
+
+  const buildOperation = async (deposit: (typeof deposits)[number]): Promise<IGenericPaymasterWithdrawalPayload> => {
+    const depositPool = pools.get(deposit.pool)!;
+    // One fresh sender per note (derived per deposit in deterministic mode, random otherwise): each
+    // operation is the sender's first, so nonce 0 and its own EIP-7702 authorization are always right.
+    // The proof always names the sender as recipient — `relayWithdraw` only accepts the recipient as
+    // caller — and, without user tail calls, the sender forwards the note to the real recipient.
+    const signer = await resolveIndependentSigner(deposit);
+    const senderAddress = BigInt(signer.address) as Address;
+    const recipient = senderAddress;
+    // A retry of the same note reuses the same deterministic sender, so nothing is assumed about its
+    // state: the EntryPoint nonce (userOp sequence) and the EOA nonce (transaction count, consumed by
+    // EIP-7702 authorizations) are read separately, and a sender that already delegates to
+    // Simple7702Account gets no new authorization at all.
+    const [senderNonce, senderTxCount, senderCode] = await Promise.all([
+      dataService.getEntryPointNonce(BigInt(entryPointAddress) as Address, senderAddress),
+      dataService.getAccountNonce(senderAddress),
+      dataService.getCode(senderAddress),
+    ]);
