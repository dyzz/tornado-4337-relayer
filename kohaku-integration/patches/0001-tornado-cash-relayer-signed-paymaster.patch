 // Configs
 export { TornadoCashConfigs, E_ADDRESS, TornadoPaymasterConfigs } from './config.js';
+
+// Relayer-signed paymaster (thin relayer over ERC-4337)
+export { RelayerPaymasterClient, RelayerPaymasterError } from './paymaster/relayer-paymaster-client';
+export type { RelayerQuote, RelayerPaymasterFields, RelayerSponsorContext } from './paymaster/relayer-paymaster-client';
