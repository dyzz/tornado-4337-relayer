@@ -0,0 +1,169 @@
+import { hexToBigInt, parseAbi, toHex, type Address, type Hex } from 'viem';
+
+import { SerializedUserOperation, UserOpGasLimits } from '../interfaces/user-ops.interface';
+
+/**
+ * Client for a *relayer-signed* paymaster service (thin Tornado relayer).
+ *
+ * The relayer exposes ERC-7677 (`pm_getPaymasterStubData`, `pm_getPaymasterData`)
+ * plus `tornado_quote`, which returns the fee a withdrawal proof must bind so the
+ * paymaster is reimbursed for the sponsored gas. The withdraw runs in the userOp's
+ * callData, executed by the 7702 sender, rather than during paymaster validation.
+ *
+ * That does not make the paymaster indifferent to which account executes it: the relayer
+ * sponsors only account implementations it knows (Simple7702Account by default), because
+ * an account that ignored the calldata would spend the sponsored gas without performing
+ * the withdrawal, and the sponsorship binds that implementation on-chain. The paymaster is
+ * also staked on the EntryPoint, which ERC-7562 requires of a paymaster that reads its own
+ * storage during validation.
+ */
+/**
+ * `TornadoRelayerPaymaster.relayWithdraw`: the sponsoring withdraw is executed by the paymaster
+ * (as the DAO-registered relayer, through TornadoRouter -> RelayerRegistry.burn) on behalf of the
+ * recipient, which must be the calling account.
+ */
+export const relayerPaymasterAbi = parseAbi([
+  'function relayWithdraw(address pool, bytes proof, bytes32 root, bytes32 nullifierHash, address recipient, address relayer, uint256 fee)',
+]);
+
+export interface RelayerQuote {
+  /** Address the proof must name as `relayer` (the paymaster, or an existing relayer's master EOA). */
+  relayer: Address;
+  /** Paymaster whose `relayWithdraw` the userOp calls for the sponsoring note. */
+  paymaster: Address;
+  entryPoint: Address;
+  instance: Address;
+  denomination: bigint;
+  /** address(0) for ETH pools; `fee`, `serviceFee` and `denomination` are in this token's units. */
+  feeToken: Address;
+  decimals: number;
+  symbol: string;
+  /** feeToken base units per 1e18 wei (0 for ETH). */
+  tokenPerEth: bigint;
+  serviceFee: bigint;
+  gas: UserOpGasLimits;
+  maxFeePerGas: bigint;
+  maxPriorityFeePerGas: bigint;
+  fee: bigint;
+  validForSec: number;
+}
+
+export interface RelayerPaymasterFields {
+  paymaster: Address;
+  paymasterData: Hex;
+  paymasterVerificationGasLimit?: Hex;
+  paymasterPostOpGasLimit?: Hex;
+}
+
+export interface RelayerSponsorContext {
+  refundTo?: Address;
+}
+
+type UnsignedOp = Omit<SerializedUserOperation, 'signature'> & { signature?: Hex };
+
+export class RelayerPaymasterError extends Error {
+  constructor(message: string, public readonly code?: number) {
+    super(message);
+    this.name = 'RelayerPaymasterError';
+  }
+}
+
+export class RelayerPaymasterClient {
+  constructor(
+    private readonly url: string,
+    private readonly fetchFn: typeof fetch = (...args) => fetch(...args),
+  ) {}
+
+  private async request<T>(method: string, params: unknown[]): Promise<T> {
+    const res = await this.fetchFn(this.url, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      // JSON has no bigint. Kohaku carries addresses and amounts as bigints internally, and the ERC-7677
+      // payload is hex throughout, so anything still numeric here is serialized as a 0x quantity rather
+      // than throwing "Do not know how to serialize a BigInt" at the point of sending.
+      body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }, (_key, value) =>
+        typeof value === 'bigint' ? toHex(value) : value,
+      ),
+    });
+    const body = (await res.json()) as { result?: T; error?: { code: number; message: string } };
+
+    if (body.error) throw new RelayerPaymasterError(`${method}: ${body.error.message}`, body.error.code);
+
+    return body.result as T;
+  }
+
+  async quote(params: {
+    instance: Address;
+    tailCallsGas?: bigint;
+    gas?: Partial<UserOpGasLimits>;
+    maxFeePerGas?: bigint;
+  }): Promise<RelayerQuote> {
+    interface RawQuote {
+      relayer: Address;
+      paymaster: Address;
+      entryPoint: Address;
+      instance: Address;
+      denomination: Hex;
+      feeToken: Address;
+      decimals: number;
+      symbol: string;
+      tokenPerEth: Hex;
+      serviceFee: Hex;
+      gas: Record<keyof UserOpGasLimits, Hex>;
+      maxFeePerGas: Hex;
+      maxPriorityFeePerGas: Hex;
+      fee: Hex;
+      validForSec: number;
+    }
+    const raw = await this.request<RawQuote>('tornado_quote', [{
+      instance: params.instance,
+      tailCallsGas: params.tailCallsGas !== undefined ? toHex(params.tailCallsGas) : undefined,
+      gas: params.gas
+        ? Object.fromEntries(Object.entries(params.gas).map(([k, v]) => [k, v === undefined ? undefined : toHex(v)]))
+        : undefined,
+      maxFeePerGas: params.maxFeePerGas !== undefined ? toHex(params.maxFeePerGas) : undefined,
+    }]);
+
+    return {
+      relayer: raw.relayer,
+      paymaster: raw.paymaster,
+      entryPoint: raw.entryPoint,
+      instance: raw.instance,
+      denomination: hexToBigInt(raw.denomination),
+      feeToken: raw.feeToken,
+      decimals: raw.decimals,
+      symbol: raw.symbol,
+      tokenPerEth: hexToBigInt(raw.tokenPerEth),
+      serviceFee: hexToBigInt(raw.serviceFee),
+      gas: {
+        callGasLimit: hexToBigInt(raw.gas.callGasLimit),
+        verificationGasLimit: hexToBigInt(raw.gas.verificationGasLimit),
+        preVerificationGas: hexToBigInt(raw.gas.preVerificationGas),
+        paymasterVerificationGasLimit: hexToBigInt(raw.gas.paymasterVerificationGasLimit),
+        paymasterPostOpGasLimit: hexToBigInt(raw.gas.paymasterPostOpGasLimit),
+      },
+      maxFeePerGas: hexToBigInt(raw.maxFeePerGas),
+      maxPriorityFeePerGas: hexToBigInt(raw.maxPriorityFeePerGas),
+      fee: hexToBigInt(raw.fee),
+      validForSec: raw.validForSec,
+    };
+  }
+
+  getPaymasterStubData(
+    op: UnsignedOp,
+    entryPoint: Address,
+    chainId: number,
+    context: RelayerSponsorContext = {},
+  ): Promise<RelayerPaymasterFields> {
+    return this.request('pm_getPaymasterStubData', [op, entryPoint, toHex(chainId), context]);
+  }
+
+  getPaymasterData(
+    op: UnsignedOp,
+    entryPoint: Address,
+    chainId: number,
+    context: RelayerSponsorContext = {},
+  ): Promise<RelayerPaymasterFields> {
+    return this.request('pm_getPaymasterData', [op, entryPoint, toHex(chainId), context]);
+  }
+}
